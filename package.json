{
  "name": "bucks2bars",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:server:dev\" \"npm:client:dev\"",
    "client:dev": "vite --config frontend/vite.config.js",
    "server:dev": "node --watch backend/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
